#!/bin/sh
set -eu
cd "$(dirname "$0")"
case "${1:-help}" in
  build) npm ci --no-audit --no-fund; npm run check; npm test; npm run build ;;
  install) exec node scripts/install-service.mjs ;;
  run) shift; exec node build/server.mjs "$@" ;;
  start) systemctl --user start garnet.service; if systemctl --user is-enabled garnet-https.service >/dev/null 2>&1; then systemctl --user start garnet-https.service; fi ;;
  stop) if systemctl --user is-active --quiet garnet-https.service; then systemctl --user stop garnet-https.service; fi; systemctl --user stop garnet.service ;;
  update) "$0" build; systemctl --user restart garnet.service; if systemctl --user is-enabled garnet-https.service >/dev/null 2>&1; then systemctl --user restart garnet-https.service; fi ;;
  logs) exec journalctl --user -u garnet.service -n 80 -f ;;
  status) systemctl --user status garnet.service garnet-mongo.service --no-pager ;;
  test) npm run check; npm test; npm run test:e2e ;;
  *) echo 'Usage: ./garnet {build|install|run|start|stop|update|logs|status|test}' ;;
esac
